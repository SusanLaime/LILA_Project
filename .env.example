# Copia este archivo como ".env" y ajusta los valores.
# NUNCA subas el archivo .env al repositorio (ya está en .gitignore).

# Puerto del servidor
PORT=3000

# Ruta del archivo de la base de datos SQLite (se crea sola al iniciar)
DB_PATH=database/lila.db

# Texto secreto para firmar los tokens de sesión.
# Cámbialo por un texto largo y aleatorio en tu .env (este es solo un ejemplo).
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
